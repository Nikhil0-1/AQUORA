# ============================================
# AQUORA Admin Panel — Frontend Environment
# ============================================
# Copy to .env in this directory.
# Variables prefixed with VITE_ are PUBLIC.
# ============================================

# Supabase (Public — safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API (development)
VITE_API_BASE_URL=http://localhost:3001

# Payment Provider Display
VITE_PAYMENT_PROVIDER=NOT_CONFIGURED
