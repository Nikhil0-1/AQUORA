# ============================================
# AQUORA Admin Panel — Backend Environment
# ============================================
# Copy to .env in this directory.
# ALL variables here are SERVER-SIDE SECRETS.
# NEVER expose these in frontend code.
# ============================================

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Machine Authentication
MACHINE_AUTH_SECRET=

# Server
PORT=3001
NODE_ENV=development
