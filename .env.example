# ============================================
# AQUORA Smart Sanitizer Vending Platform
# Root Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================

# --- Application ---
NODE_ENV=development
PORT=3001
TIMEZONE=Asia/Kolkata

# ============================================
# PUBLIC VARIABLES (safe for browser/frontend)
# ============================================

# Backend API URLs (development defaults)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Supabase Public Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Kiosk Display
VITE_KIOSK_MODE=false
VITE_PAYMENT_PROVIDER=NOT_CONFIGURED

# ============================================
# SERVER SECRETS (NEVER expose to frontend)
# ============================================

# Supabase Server-Side
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway (Razorpay)
# Get these from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Machine Authentication
MACHINE_SECRET_KEY=
MACHINE_AUTH_SECRET=
MACHINE_API_URL=http://localhost:3001/api/v1
