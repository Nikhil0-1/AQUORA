# ============================================
# AQUORA Smart Sanitizer Vending Platform
# .gitignore — GitHub Safety
# ============================================

# === Node.js / JavaScript ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# === Build Artifacts ===
dist/
build/
.cache/
.vite/
.next/
.output/
*.tsbuildinfo

# === Environment Files & Credentials (CRITICAL) ===
.env
.env.*
!.env.example

# === Arduino / ESP32 Secrets ===
secrets.h
!secrets.h.example
*.secret
*.pem
*.key
*.p12
*.pfx

# === Supabase Local ===
.supabase/
supabase/.temp/
.temp/


# === Arduino IDE / ESP32 Build Artifacts ===
*.hex
*.bin
*.elf
*.o
*.a
*.d
*.map
*.lst
__pycache__/
*.pyc

# === IDE / Editor Files ===
.vscode/
.idea/
*.suo
*.user
*.userossv
*.sln
*.docstates
*.swp
*.swo
*~

# === OS Files ===
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# === Logs ===
logs/
*.log

# === Temporary Files ===
tmp/
temp/
*.tmp

# === Coverage / Test ===
coverage/
.nyc_output/

# === Package Manager Lock Files (keep package-lock.json) ===
yarn.lock
pnpm-lock.yaml

# === Skills / Agent Config (local only) ===
skills-lock.json
.agents/
